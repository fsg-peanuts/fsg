# Copy to .env.local for local development. NEVER put secrets in NEXT_PUBLIC_* variables:
# everything prefixed NEXT_PUBLIC_ is embedded in the public JavaScript bundle.

# Public site URL (used for canonical links, sitemap, Open Graph).
# GitHub Actions sets this automatically from the repository owner.
NEXT_PUBLIC_SITE_URL=https://fsg-peanuts.github.io/fsg

# Base path. Production builds default to /fauzey-peanut. Use an empty value on a custom domain.
# NEXT_PUBLIC_BASE_PATH=

# Checkout mode: "demo" (default; no payments are taken) or "live" (requires a real backend).
NEXT_PUBLIC_CHECKOUT_MODE=demo

# Payment provider identifier for the adapter (non-secret). Live providers need a server/Worker.
NEXT_PUBLIC_PAYMENT_PROVIDER=none

# Server-side secrets (Paystack keys, etc.) belong ONLY in a future Cloudflare Worker / server
# environment, never in this static site. See docs/ARCHITECTURE.md.
